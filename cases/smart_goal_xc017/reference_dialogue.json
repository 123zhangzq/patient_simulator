      "end_time": "00:30:22.206",
      "speaker_role": "participant",
      "speaker_code": "XC017",
      "text": "And then usually I pack like one month in advance instead of one, two days before.",
      "address_code": "CD",
      "dialog_id": "dg008",
      "include": "yes"
    },
    {
      "excel_row": 432,
