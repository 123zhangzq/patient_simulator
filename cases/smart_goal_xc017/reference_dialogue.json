      "end_time": "00:30:15.305",
      "speaker_role": "participant",
      "speaker_code": "XC017",
      "text": "For instance, I go holiday, I will have a listing of all the things that I might need to take or I don't need to take.",
      "address_code": "CD",
      "dialog_id": "dg008",
      "include": "yes"
    },
